# PostgreSQL Dockerfile
FROM postgres:16-alpine

# Set environment variables (can be overridden by docker-compose)
ENV POSTGRES_USER=nest
ENV POSTGRES_PASSWORD=nest
ENV POSTGRES_DB=nestdb
ENV PGDATA=/var/lib/postgresql/data/pgdata

# Create directory for initialization scripts
RUN mkdir -p /docker-entrypoint-initdb.d

# Copy initialization scripts (if any)
# Uncomment the line below if you have initialization scripts
# COPY ./docker/postgres/init-scripts/*.sql /docker-entrypoint-initdb.d/

# Set proper permissions
RUN chmod -R 755 /docker-entrypoint-initdb.d

# Expose PostgreSQL port
EXPOSE 5432

# The official postgres image will automatically run any .sql, .sh, or .sql.gz files
# found in /docker-entrypoint-initdb.d/ when the container is first started
# (only if the data directory is empty)
